# Copy to .env and adjust. Django reads this file via python-dotenv
# (settings.py). The .env file itself is gitignored.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Default is SQLite (db.sqlite3 in the project root), fine for local dev.
# Set DB_ENGINE=mysql and fill in the MariaDB/MySQL connection details to
# use the target database.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# MariaDB/MySQL settings (only used when DB_ENGINE=mysql):
# DB_NAME=shopify_classifier
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306